.help .tooltip { width: 130px; padding: 6px; font-family: "Open Sans", sans-serif; font-size: 12px; line-height: 17px; color: var(--color-neutral-0,#fff); text-align: center; text-transform: none; background: var(--color-black-a80,rgba(0,0,0,.8)); border-radius: 6px; opacity: 0; transition: opacity 0.2s; white-space: normal; }

